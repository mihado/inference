# Shared host weight cache, bind-mounted into every slot. Unset ->
# $HOME/.hf-cache (the compose default). Create it once:
#   mkdir -p "$HOME/.hf-cache"
# HF_CACHE=/mnt/fast/hf-cache

# Image tag. RTX A4000 = Ampere 8.6 -> 86-1.9.1. The generic cuda-1.9.1 also
# works (sm_80 build, binary-compatible). See README for the tag table.
TEI_IMAGE_TAG=86-1.9.1

# vLLM image for the nano slot. voyage-4-nano is bf16 and needs bf16, which TEI
# does not offer (fp16 NaNs, fp32 OOMs), so it runs on vLLM.
VLLM_IMAGE_TAG=v0.16.0

# Per-slot model and placement. Defaults live in docker-compose.yml; override
# here, or use scripts/model.sh / `make load` to swap a slot.
# Slots 1-5 pin GPU 0 (rerankers); hf-6 and nano pin GPU 1 (embedders).
#
# MODEL_1=Alibaba-NLP/gte-reranker-modernbert-base
# MODEL_2=BAAI/bge-reranker-v2-m3
# MODEL_3=cross-encoder/ms-marco-MiniLM-L6-v2
# MODEL_4=Alibaba-NLP/gte-multilingual-reranker-base
# MODEL_5=ibm-granite/granite-embedding-reranker-english-r2
# MODEL_6=Qwen/Qwen3-Embedding-0.6B
#
# The nano embedder is a vLLM service, not a TEI slot.
# MODEL_NANO=voyageai/voyage-4-nano
# NANO_GPU_MEMORY=0.5
#
# GPU_1=0
# GPU_2=0
# GPU_3=0
# GPU_4=0
# GPU_5=0
# GPU_6=1
# GPU_NANO=1
#
# PORT_1=8080
# PORT_2=8081
# PORT_3=8082
# PORT_4=8083
# PORT_5=8084
# PORT_6=8085
# PORT_NANO=8086
