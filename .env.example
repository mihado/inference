# Host directory shared by every TEI instance (Hugging Face hub cache).
# Unset -> $HOME/.hf-cache (the compose default). Set it to place the cache
# elsewhere, e.g. on a larger disk:
# HF_CACHE=/mnt/fast/hf-cache

# Image tag MUST match the GPU compute capability. RTX A4000 = Ampere 8.6 ->
# 86-1.9.1. Others: 1.9 = sm80 (A100/A30), 89-1.9 = sm89 (RTX 4000/5000),
# hopper-1.9, turing-1.9 (T4/RTX 2000). The generic tag runs everywhere in a
# family but is not tuned for the card. If the log shows "on Cpu" instead of
# "on Cuda" (driver/CUDA mismatch — see README), fall back to cuda-1.9.1.
TEI_IMAGE_TAG=86-1.9.1

# GPU index per instance. The box has two; both default to GPU 1. Move one to
# 0 if that card is free, or keep both on 1 (the 4B ~8 GB + 0.6B ~1.2 GB fit
# in one 16 GB A4000).
TEI_GPU_4B=1
TEI_GPU_06B=1

# Host ports.
TEI_4B_PORT=8080
TEI_06B_PORT=8081
