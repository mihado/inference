# Shared host weight cache. It is bind-mounted into every server. Unset ->
# $HOME/.hf-cache (the compose default). Create it once:
#   mkdir -p "$HOME/.hf-cache"
# HF_CACHE=/mnt/fast/hf-cache

# TEI image tag. The RTX A4000 is Ampere 8.6, thus 86-1.9.1. The generic
# cuda-1.9.1 also works (sm_80 build). See README for the tag table.
TEI_IMAGE_TAG=86-1.9.1

# vLLM image tag for the nano embedder. voyage-4-nano needs bf16, and TEI does
# not offer bf16. Thus the model runs on vLLM.
VLLM_IMAGE_TAG=v0.16.0

# Model and placement of each server. The defaults are in docker-compose.yml.
# Both servers use GPU 1. GPU 0 stays free.
#
# MODEL_RERANKER=Alibaba-NLP/gte-reranker-modernbert-base
# MODEL_NANO=voyageai/voyage-4-nano
# NANO_GPU_MEMORY=0.5
#
# GPU_RERANKER=1
# GPU_NANO=1
#
# PORT_RERANKER=8080
# PORT_NANO=8086
# ROUTER_PORT=8100
