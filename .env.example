# Every variable below has a compose default; this file documents the override
# points. Copying it next to the compose files changes nothing.
#   cp .env.example .env

# Shared host weight cache, bind-mounted into every server.
# HF_CACHE=/mnt/fast/hf-cache

# Image tags. TEI 86-1.9.1 is the Ampere build for the RTX A4000
# (docs/operations.md, "Image tag"); the vLLM tag serves voyage-4-nano, which needs bf16.
# TEI_IMAGE_TAG=86-1.9.1
# VLLM_IMAGE_TAG=v0.16.0
# OLLAMA_IMAGE_TAG=0.34.3

# Default stack: model per service, GPU per replica, port per service.
# MODEL_RERANKER=Alibaba-NLP/gte-reranker-modernbert-base
# MODEL_VOYAGE_EMBED=voyageai/voyage-4-nano
# VOYAGE_GPU_MEMORY=0.5
# GPU_RERANKER=0
# GPU_RERANKER_B=1
# GPU_VOYAGE_EMBED=0
# GPU_VOYAGE_EMBED_B=1
# PORT_RERANKER=8021
# PORT_RERANKER_B=8022
# PORT_VOYAGE_EMBED=8001
# PORT_VOYAGE_EMBED_B=8002
# ROUTER_PORT=8100

# rerankers profile: the four bake-off rerankers, all on GPU 0 by default.
# MODEL_BGE_RERANKER=BAAI/bge-reranker-v2-m3
# MODEL_MS_MARCO=cross-encoder/ms-marco-MiniLM-L6-v2
# MODEL_GTE_MULTILINGUAL=Alibaba-NLP/gte-multilingual-reranker-base
# MODEL_GRANITE_RERANKER=ibm-granite/granite-embedding-reranker-english-r2
# GPU_EXTRAS=0
# PORT_BGE_RERANKER=8099
# PORT_MS_MARCO=8098
# PORT_GTE_MULTILINGUAL=8097
# PORT_GRANITE_RERANKER=8096

# qwen-embed profile: the Qwen3 embedder pair, one replica per GPU.
# MODEL_QWEN_EMBED=Qwen/Qwen3-Embedding-0.6B
# GPU_QWEN_EMBED=0
# GPU_QWEN_EMBED_B=1
# PORT_QWEN_EMBED=8003
# PORT_QWEN_EMBED_B=8004

# laya profile: the decision model on its own runtime. LAYA_SUBFOLDER is empty
# for the English root checkpoint, or one of multilingual | typed-decisions.
# MODEL_LAYA=convaiinnovations/laya
# LAYA_SUBFOLDER=
# LAYA_MAX_TEXTS=64
# PORT_LAYA=8043
# The _B ports serve each profile's second replica: CONCURRENCY=2 on the
# matching make target starts it on the other card.
# PORT_LAYA_B=8044

# agentjev profile: the decision model on its own runtime (agentjev/README.md).
# AGENTJEV_REPO=aimeigaoshou/agent-jev
# AGENTJEV_BASE=Qwen/Qwen3-0.6B
# AGENTJEV_DEVICE=
# AGENTJEV_MAX_TEXTS=32
# PORT_AGENTJEV=8045
# PORT_AGENTJEV_B=8046

# jina profile: the listwise reranker on its own runtime. Non-commercial
# weights (CC-BY-NC-4.0): local dev and eval only, never serving.
# MODEL_JINA_RERANKER=jinaai/jina-reranker-v3.5
# JINA_DEVICE=
# JINA_MAX_TEXTS=64
# PORT_JINA=8095
# PORT_JINA_B=8094

# jina-embed profile: the multimodal embedder on its own runtime (jina/README.md).
# Same non-commercial terms, same local-dev scope. JINA_EMBED_TASK picks the
# task adapter; JINA_EMBED_MODALITY picks the towers (vision = text + image,
# omni = plus audio and video).
# MODEL_JINA_EMBED=jinaai/jina-embeddings-v5-omni-small
# JINA_EMBED_TASK=retrieval
# JINA_EMBED_MODALITY=vision
# JINA_EMBED_DEVICE=
# JINA_EMBED_MAX_TEXTS=64
# PORT_JINA_EMBED=8093
# PORT_JINA_EMBED_B=8092

# omnijev profile: the omni-modal decision model on its own runtime
# (omnijev/README.md). Apache-2.0 code and weights. Defaults to the 0.8B size;
# OMNIJEV_SIZE=2|4 switches, or set OMNIJEV_CKPT / OMNIJEV_BASE directly.
# OMNIJEV_SIZE=0.8
# OMNIJEV_CKPT=
# OMNIJEV_BASE=
# OMNIJEV_MAX_PIXELS=602112
# OMNIJEV_MAX_QUESTIONS=32
# PORT_OMNIJEV=8041
# PORT_OMNIJEV_B=8042

# ollama profile: the GGUF runner beside the router (own port, no label).
# GPU_OLLAMA=1
# OLLAMA_NUM_PARALLEL=3
# OLLAMA_MAX_LOADED_MODELS=3
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_HOME=$HOME/.ollama
# PORT_OLLAMA=11434
